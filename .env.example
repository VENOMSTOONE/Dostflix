# Dostflix Environment Configuration Template

# Optional Supabase Cloud Storage (Defaults gracefully to local IndexedDB vault)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional Vision AI Configuration
# When configured, Dostflix leverages multimodal Vision AI for deeper scene & activity understanding.
# When omitted, Dostflix automatically executes client-side deterministic Computer Vision
# (Perceptual Hashing, Laplacian Sharpness, Exposure/Contrast Scoring, Document Detection) with 100% functionality.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_VISION_API_ENDPOINT=/api/analyze-vision
